# PromptForge — environment template. Copy to .env and fill in.

# PostgreSQL connection string.
# Local dev example (Homebrew Postgres): postgresql://USER@127.0.0.1:5432/promptforge_dev?schema=public
# Free-tier hosting: use a Neon or Supabase connection string.
DATABASE_URL="postgresql://user@127.0.0.1:5432/promptforge_dev?schema=public"

# Primary AI engine — Anthropic Claude. Keep this server-side only.
# The default balances high coding quality and cost; pin a different active
# Claude model ID if your account requires one.
ANTHROPIC_API_KEY=""
ANTHROPIC_BASE_URL="https://api.anthropic.com"
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Strongly recommended for any public deployment. Teammates enter this code
# once; the Claude key and all API endpoints stay behind an HTTP-only cookie.
PROMPTFORGE_ACCESS_CODE=""

# Optional secondary AI engine — Cerebras (OpenAI-compatible API).
# Used only when no Anthropic key is configured.
CEREBRAS_API_KEY=""
CEREBRAS_BASE_URL="https://api.cerebras.ai/v1"
CEREBRAS_MODEL="gpt-oss-120b"

# Phase 3 hand-off connectors — both optional. Leave empty to fall back to
# "copy the hand-off text" in the UI; the app works fully with neither set.

# GitHub: a fine-grained personal access token with "Issues: write" on the
# target repo, and the repo in "owner/repo" form.
GITHUB_TOKEN=""
GITHUB_REPO=""

# Jira: an API token from https://id.atlassian.com/manage-profile/security/api-tokens,
# the account email that owns it, your site's base URL, and the target project key.
JIRA_BASE_URL=""
JIRA_EMAIL=""
JIRA_API_TOKEN=""
JIRA_PROJECT_KEY=""
JIRA_ISSUE_TYPE="Task"
