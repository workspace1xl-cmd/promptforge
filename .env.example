# PromptForge — environment template. Copy to .env and fill in.

# PostgreSQL connection string.
# Local dev example (Homebrew Postgres): postgresql://USER@127.0.0.1:5432/promptforge_dev?schema=public
# Free-tier hosting: use a Neon or Supabase connection string.
DATABASE_URL="postgresql://user@127.0.0.1:5432/promptforge_dev?schema=public"

# AI engine — Cerebras (OpenAI-compatible chat completions API).
# Leave CEREBRAS_API_KEY empty to use the built-in deterministic local engine.
CEREBRAS_API_KEY=""
CEREBRAS_BASE_URL="https://api.cerebras.ai/v1"
CEREBRAS_MODEL="gpt-oss-120b"

# Phase 3 hand-off connectors — both optional. Leave empty to fall back to
# "copy the hand-off text" in the UI; the app works fully with neither set.

# GitHub: a fine-grained personal access token with "Issues: write" on the
# target repo, and the repo in "owner/repo" form.
GITHUB_TOKEN=""
GITHUB_REPO=""

# Jira: an API token from https://id.atlassian.com/manage-profile/security/api-tokens,
# the account email that owns it, your site's base URL, and the target project key.
JIRA_BASE_URL=""
JIRA_EMAIL=""
JIRA_API_TOKEN=""
JIRA_PROJECT_KEY=""
JIRA_ISSUE_TYPE="Task"
