// PromptForge — Prisma schema (Prisma 7, PostgreSQL)
// Data model per the Phase 0 spec: Organization, User, Department,
// FormTemplate (JSON schema per dept), ComplianceRule, PromptPattern,
// FormSubmission, GeneratedPrompt (versioned), SOPDocument.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  users       User[]
  departments Department[]
}

model User {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email     String       @unique
  name      String?
  role      String       @default("member") // owner | admin | member
  createdAt DateTime     @default(now())
}

model Department {
  id               String            @id @default(cuid())
  orgId            String
  org              Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  key              String // stable slug, e.g. "software-development"
  name             String
  description      String?
  icon             String? // short code shown in the UI, e.g. "DEV"
  order            Int               @default(0)
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  templates        FormTemplate[]
  complianceRules  ComplianceRule[]
  submissions      FormSubmission[]
  generatedPrompts GeneratedPrompt[]
  fieldOverrides   FieldOverride[]

  @@unique([orgId, key])
}

// The department's form definition, stored as JSON so new departments are
// config, not code. Versioned; the active row is what the renderer reads.
model FormTemplate {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  version      Int        @default(1)
  active       Boolean    @default(true)
  schema       Json
  createdAt    DateTime   @default(now())

  @@unique([departmentId, version])
}

// Per-department hard constraints enforced in every generated prompt.
model ComplianceRule {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  code         String
  label        String
  description  String
  severity     String     @default("hard") // hard | soft
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())

  @@unique([departmentId, code])
}

// Reusable prompt-engineering pattern catalog (Vanderbilt patterns + techniques).
model PromptPattern {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String
  whenToUse   String
  createdAt   DateTime @default(now())
}

model FormSubmission {
  id               String            @id @default(cuid())
  departmentId     String
  department       Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  useCase          String
  answers          Json
  name             String? // set when the user saves this as a reusable template
  isTemplate       Boolean           @default(false)
  createdAt        DateTime          @default(now())
  generatedPrompts GeneratedPrompt[]
}

model GeneratedPrompt {
  id           String         @id @default(cuid())
  submissionId String
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  version      Int            @default(1)
  useCase      String
  technique    String // zero-shot | few-shot | chain-of-thought | react
  patternsUsed String[]
  provider     String // local-engine | cerebras:gpt-oss-120b
  outputFormat String
  prompt       String         @db.Text
  qualityScore Int? // 0-100, from the Phase 2 critique pass (Google whitepaper checklist)
  variantLabel String? // "A" | "B" when generated as part of an A/B comparison, else null
  meta         Json?
  createdAt    DateTime       @default(now())
  sop          SOPDocument?
}

model SOPDocument {
  id                String          @id @default(cuid())
  generatedPromptId String          @unique
  generatedPrompt   GeneratedPrompt @relation(fields: [generatedPromptId], references: [id], onDelete: Cascade)
  title             String
  body              String          @db.Text
  createdAt         DateTime        @default(now())
}

// Phase 3 — lets an org admin require or lock a department's field at
// runtime, without a code deploy. A "locked" field is fixed to lockedValue
// and hidden from the wizard entirely; the fixed value still flows into
// every generated prompt for that department.
model FieldOverride {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  fieldId      String // matches a FieldDef.id in the department's FormTemplate.schema
  required     Boolean? // null = no override, defer to the field's own config
  locked       Boolean    @default(false)
  lockedValue  Json? // only meaningful when locked = true
  updatedAt    DateTime   @updatedAt
  createdAt    DateTime   @default(now())

  @@unique([departmentId, fieldId])
}

// Phase 3 — an audit trail of hand-off attempts (GitHub issue / Jira ticket /
// manual copy), success or failure, for the analytics reuse-rate view and so
// a failed external call is never silent.
model HandoffLog {
  id                String   @id @default(cuid())
  generatedPromptId String
  target           String // github | jira | copy
  status           String // success | failed | not_configured
  detail           String? // ticket URL on success, error summary on failure
  createdAt        DateTime @default(now())
}
